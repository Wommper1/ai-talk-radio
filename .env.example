# Copy to .env (git-ignored). Every variable is optional; the defaults work
# for the standard local setup. Model, voice and station settings live in
# config.json, which is edited from the Settings screen.

# Port the server listens on (the launcher moves to a free port if 3000 is taken).
# PORT=3000

# Set to "production" when running `npm run serve`.
# NODE_ENV=development

# Python executable for the project-private Edge TTS install.
# Default: the environment created by `npm run setup-edge-tts`.
# EDGE_TTS_PYTHON=C:\path\to\edge-tts\Scripts\python.exe

# King Orion's Realm bridge (see docs/WORLD_API_V1.md).
# Bearer token for the world command API. If unset, the token in
# data/world_api_token.txt is used.
# WORLD_API_TOKEN=
# Python executable used to run scripts/world_command_bridge.py.
# REALM_PYTHON=python
# Root folder of the realm project, used by `npm run world:smoke`.
# REALM_ROOT=C:\path\to\king_orions_realm

# Base URL the e2e / smoke / burn-in scripts talk to.
# RADIO_URL=http://localhost:3000
